__pycache__/
*.py[cod]
*.log
*.tmp
.venv/
venv/
.env
.env.*
!.env.example
*token*.json
*credential*
cursor-runtime-pack*
host-main.cjs
.idea/
.vscode/
admin_config.json

# Generated image artifacts from /v1/images/generations
media/*
!media/.gitkeep

# Keep Windows client credential module (pattern *credential* would ignore it)
!windows/credentials.py
!docs/windows-credential-import.md

# Windows / PyInstaller build outputs
windows/build/
windows/dist/
windows/*.spec.bak

# Tauri desktop
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# Keep synced gateway resources (generated) out of secret patterns; allow credential-named modules under desktop
!desktop/
!desktop/**

desktop/crates/*/target/
